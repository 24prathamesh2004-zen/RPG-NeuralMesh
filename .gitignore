# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Virtualenvs (never commit these) ─────────────────────────────────────────
.venv/
venv/
env/

# ── Environment / secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example
app/.env
app/ui/.env
app/ui/.env.local
app/.neuralmesh/
# Chroma stores of the knowledge packs, built by python -m knowledge.packgen
app/neuralmesh_kb_pack/data_pack/*/packs/*/build/

# ── Node / Vite (never commit these) ─────────────────────────────────────────
node_modules/
dist/
.vite/
*.local

# ── Editors / OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store

# ── Misc ─────────────────────────────────────────────────────────────────────
*.log

# the lock an import holds on the talent import folder
.import.lock
