{
 "contract": "rpg-neuralmesh.context",
 "version": "1.1",
 "supported_versions": [
  "1.0",
  "1.1"
 ],
 "endpoint": "POST /api/v1/context/{tool}",
 "statuses": [
  "ok",
  "partial",
  "no_evidence",
  "blocked",
  "needs_input",
  "refused"
 ],
 "problem_codes": {
  "unauthenticated": {
   "http": 401,
   "status": null,
   "title": "The service token is missing, invalid or expired"
  },
  "unsupported_version": {
   "http": 400,
   "status": null,
   "title": "The contract version is not served"
  },
  "not_an_envelope": {
   "http": 400,
   "status": null,
   "title": "The body is not a request envelope"
  },
  "tool_mismatch": {
   "http": 400,
   "status": null,
   "title": "The path and the body name different tools"
  },
  "unknown_tool": {
   "http": 404,
   "status": null,
   "title": "No such tool"
  },
  "not_allowed": {
   "http": 403,
   "status": null,
   "title": "This application may not make this call"
  },
  "service_unavailable": {
   "http": 503,
   "status": null,
   "title": "NeuralMesh could not complete the call"
  },
  "invalid_input": {
   "http": 200,
   "status": "refused",
   "title": "An input field is missing or wrong"
  },
  "not_found": {
   "http": 200,
   "status": "refused",
   "title": "The id is not in the context graph"
  },
  "company_not_connected": {
   "http": 200,
   "status": "refused",
   "title": "The caller's company has no Mesh Node"
  },
  "needs_choice": {
   "http": 200,
   "status": "needs_input",
   "title": "A choice is needed"
  },
  "not_released": {
   "http": 200,
   "status": "blocked",
   "title": "The owners released nothing for this purpose"
  },
  "node_unavailable": {
   "http": 200,
   "status": "partial",
   "title": "At least one company did not answer"
  },
  "pack_refused": {
   "http": 200,
   "status": null,
   "title": "At least one pack was not loaded"
  }
 },
 "rules": [
  "data follows the tool's data schema when the status is ok, partial, no_evidence or blocked",
  "a reader ignores fields it does not know and logs an unknown problem code by its title",
  "the six statuses are fixed within a major version"
 ],
 "request": {
  "$defs": {
   "Caller": {
    "additionalProperties": false,
    "description": "Who the call is for: the end user's company and roles in the application, or the group for a service call.",
    "properties": {
     "subsidiary": {
      "pattern": "^[a-z][a-z0-9-]{0,39}$",
      "title": "Subsidiary",
      "type": "string"
     },
     "roles": {
      "items": {
       "type": "string"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Roles",
      "type": "array"
     },
     "user_ref": {
      "anyOf": [
       {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "User Ref"
     }
    },
    "required": [
     "subsidiary",
     "roles"
    ],
    "title": "Caller",
    "type": "object"
   }
  },
  "description": "The one request envelope. Fields a newer minor version adds are ignored, the tool's input is checked by the tool.",
  "properties": {
   "schema_version": {
    "pattern": "^\\d+\\.\\d+$",
    "title": "Schema Version",
    "type": "string"
   },
   "tool": {
    "pattern": "^[a-z][a-z_]{0,59}$",
    "title": "Tool",
    "type": "string"
   },
   "purpose": {
    "maxLength": 40,
    "minLength": 1,
    "title": "Purpose",
    "type": "string"
   },
   "caller": {
    "$ref": "#/$defs/Caller"
   },
   "input": {
    "additionalProperties": true,
    "title": "Input",
    "type": "object"
   }
  },
  "required": [
   "schema_version",
   "tool",
   "purpose",
   "caller"
  ],
  "title": "ContextRequest",
  "type": "object"
 },
 "answer": {
  "$defs": {
   "AnswerText": {
    "additionalProperties": false,
    "properties": {
     "text": {
      "title": "Text",
      "type": "string"
     },
