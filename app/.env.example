# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-development-only-32-bytes-minimum
LOG_LEVEL=INFO
# POC local accounts, SQLite state, and the same short-lived local JWT key used by node processes.
NEURALMESH_DATABASE_PATH=.neuralmesh/accounts.db
# Required in staging/production (comma-separated), e.g.
# CORS_ALLOWED_ORIGINS=https://__APP_NAME__-fe.bravesky-d9f9eeb7.eastus2.azurecontainerapps.io
CORS_ALLOWED_ORIGINS=

# ── Azure OpenAI ─────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ── RPG NeuralMesh POC LLM ────────────────────────────────────────────────────
NEURALMESH_GROQ_API_KEY=
NEURALMESH_GROQ_MODEL=llama-3.3-70b-versatile
# Claude API key for the development model (config/model_policy.json, entry claude-dev)
NEURALMESH_ANTHROPIC_API_KEY=

# ── NeuralMesh local MCP endpoints ────────────────────────────────────────────
NEURALMESH_CEAT_URL=http://127.0.0.1:8101/mcp
NEURALMESH_KEC_URL=http://127.0.0.1:8102/mcp
NEURALMESH_ZENSAR_URL=http://127.0.0.1:8103/mcp
NEURALMESH_HARRISONS_URL=http://127.0.0.1:8104/mcp

# ── Knowledge mesh v2 ────────────────────────────────────────────────────────
# Folder with model.onnx and tokenizer.json of all-MiniLM-L6-v2. Empty means Chroma's cached copy.
NEURALMESH_EMBEDDING_MODEL_DIR=
# Model policy (tiers gateway, local, cloud). Outside development a cloud model stops the service at start.
NEURALMESH_MODEL_POLICY=config/model_policy.json
NEURALMESH_GATEWAY_API_KEY=
NEURALMESH_GATEWAY_PORT=8100
NEURALMESH_GRAPH_DB=.neuralmesh/mesh_graph.db
NEURALMESH_CENTRAL_AUDIT=.neuralmesh/central_audit.jsonl
NEURALMESH_REFRESH_GRAPH_ON_START=1
# ── Tracing ───────────────────────────────────────────────────────────────────
# OTLP/HTTP collector for spans. Empty means no export.
NEURALMESH_OTEL_ENDPOINT=
NEURALMESH_OTEL_HEADERS=
