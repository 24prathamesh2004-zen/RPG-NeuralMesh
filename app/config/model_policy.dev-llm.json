{
  "note": "For testing on a developer's own machine only: the steps use the cloud model of config/model_policy.json, and development_cloud_for_real lets it read uploads that are real data. With this file the text of a real upload is sent to the public API of that model. Outside development the service refuses a cloud model whatever this file says. Start the API with NEURALMESH_MODEL_POLICY=config/model_policy.dev-llm.json.",
  "development_cloud_for_synthetic_confidential": true,
  "models": {
    "group-gateway": {
      "id": "gpt-4.1-mini",
      "tier": "gateway",
      "base_url": "https://gateway.rpg.example/openai/v1",
      "api_key_env": "NEURALMESH_GATEWAY_API_KEY"
    },
    "local-ollama": {
      "id": "llama3.1:8b",
      "tier": "local",
      "base_url": "http://127.0.0.1:11434/v1",
      "api_key_env": ""
    },
    "groq-dev": {
      "id": "llama-3.3-70b-versatile",
      "tier": "cloud",
      "base_url": "https://api.groq.com/openai/v1",
      "api_key_env": "NEURALMESH_GROQ_API_KEY"
    },
    "claude-dev": {
      "id": "claude-sonnet-5-5",
      "tier": "cloud",
      "provider": "anthropic",
      "base_url": "https://api.anthropic.com",
      "api_key_env": "NEURALMESH_ANTHROPIC_API_KEY"
    }
  },
  "steps": {
    "answer": {
