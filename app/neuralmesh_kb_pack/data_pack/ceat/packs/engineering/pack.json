  "documents": [
    {
      "id": "ceat:E-03-01",
      "datapoint": "ceat:E-03",
      "title": "Incoming natural-rubber lot acceptance and trending",
      "kind": "report",
      "version": "2026-03",
      "tags": [
        "natural-rubber",
        "lot-acceptance",
        "quality",
        "trending",
        "supplier"
      ],
      "summary": "Incoming natural-rubber lots are accepted against a small set of quality parameters (dirt content, volatile matter, plasticity retention and Mooney viscosity) with limits agreed with suppliers. Results are trended per supplier and per lot, so drift is seen before the material reaches mixing. No formulations are included.",
      "body_file": "source/E-03-01.md",
      "concepts": [
        "concept:lot-acceptance",
        "concept:lot-quality-trending"
      ],
      "skills": [
        {
          "skill": "skill:quality-management",
          "level": "M"
        }
      ]
    },
    {
      "id": "ceat:E-03-02",
      "datapoint": "ceat:E-03",
      "title": "Warehouse storage practices for natural rubber",
      "kind": "report",
      "version": "2026-03",
      "tags": [
        "natural-rubber",
        "storage",
        "warehouse",
        "ageing",
        "fifo"
      ],
      "summary": "Rubber is stored in covered, ventilated warehouses, off the floor, away from direct sun and heat sources, with grades kept apart and first-in-first-out issue. Long-stored lots get an extra ageing check before use.",
      "body_file": "source/E-03-02.md",
      "concepts": [
        "concept:raw-material-storage",
        "concept:material-ageing"
      ],
      "skills": [
        {
          "skill": "skill:manufacturing",
          "level": "M"
        }
      ],
      "supersedes": "ceat:E-03-06"
    },
    {
      "id": "ceat:E-03-03",
      "datapoint": "ceat:E-03",
      "title": "Contamination and moisture control at receipt and handling",
      "kind": "report",
      "version": "2026-03",
      "tags": [
        "contamination",
        "moisture",
        "receipt",
        "unloading",
        "foreign-matter"
      ],
      "summary": "Unloading is done under cover, wrapping integrity is checked, and foreign matter and moisture exposure are recorded at receipt. Findings are tied to the delivery so supplier feedback has evidence.",
      "body_file": "source/E-03-03.md",
      "concepts": [
        "concept:contamination-control"
      ],
      "skills": [
        {
          "skill": "skill:manufacturing",
          "level": "L"
        }
      ]
    },
    {
      "id": "ceat:E-03-04",
      "datapoint": "ceat:E-03",
      "title": "Supplier feedback loop for raw-material quality",
      "kind": "report",
      "version": "2026-03",
      "tags": [
        "supplier",
        "feedback",
        "corrective-action",
        "scorecard"
      ],
      "summary": "Quality complaints go to suppliers with data attached, joint root-cause visits are held for repeat issues, corrective actions are tracked, and a scorecard shows quality and consistency by supplier.",
