        }
      ]
    },
    {
      "id": "raychem:E-01-03",
      "datapoint": "raychem:E-01",
      "title": "Procedure - Tests before energising",
      "kind": "report",
      "version": "2026-03",
      "tags": [
        "testing",
        "insulation-resistance",
        "withstand",
        "partial-discharge",
        "energising"
      ],
      "summary": "Before energising, the installer measures insulation resistance, applies a high voltage withstand test for the agreed time and, for cables above medium voltage, runs a partial discharge test. An insulation reading below the site limit, or a partial discharge reading above it, stops energising.",
      "body_file": "source/E-01-03.md",
      "concepts": [
        "concept:pre-energising-tests"
      ],
