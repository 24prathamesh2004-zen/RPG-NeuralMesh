          "skill": "skill:cable-accessory-installation",
          "level": "A"
        }
      ]
    },
    {
      "id": "raychem:E-01-04",
      "datapoint": "raychem:E-01",
      "title": "Procedure - Connecting cables to transformers and switchgear",
      "kind": "report",
      "version": "2026-03",
      "tags": [
        "transformer",
        "switchgear",
        "bushing",
        "connection",
        "torque"
      ],
      "summary": "At a transformer or switchgear bushing, the installer checks the phase marking, fits the termination to the bushing and tightens the lug to the set torque. The earth continuity is checked before the cover is closed.",
      "body_file": "source/E-01-04.md",
