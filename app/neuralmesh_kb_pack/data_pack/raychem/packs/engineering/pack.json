        }
      ]
    },
    {
      "id": "raychem:E-01-02",
      "datapoint": "raychem:E-01",
      "title": "Procedure - Cold-shrink and heat-shrink termination",
      "kind": "report",
      "version": "2026-02",
      "tags": [
        "termination",
        "cold-shrink",
        "heat-shrink",
        "outdoor"
      ],
      "summary": "Cold-shrink terminations suit confined spaces because they need no flame. Heat-shrink terminations suit outdoor work where a torch is allowed. Both need a clean stress-control layer and a sealed lug end.",
      "body_file": "source/E-01-02.md",
      "concepts": [
        "concept:cable-termination"
      ],
