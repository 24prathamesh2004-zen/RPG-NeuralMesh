      "id": "raychem:E-01-01",
      "datapoint": "raychem:E-01",
      "title": "Procedure - Cable joint installation",
      "kind": "report",
      "version": "2026-02",
      "tags": [
        "joint",
        "installation",
        "cable-preparation",
        "shrink-kit"
      ],
      "summary": "A joint is installed in five steps. Strip the cable to the marked lengths, clean and degrease the insulation, fit the connector, place the shrink sleeve and heat it evenly from the centre outwards. The work stops if rain or dust reaches the open cable.",
      "body_file": "source/E-01-01.md",
      "concepts": [
        "concept:cable-joint-installation"
      ],
