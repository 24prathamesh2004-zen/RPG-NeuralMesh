      "concepts": [
        "concept:latex-pre-coagulation",
        "concept:monsoon-operations"
      ]
    },
    {
      "id": "harrisons:O-05-02",
      "datapoint": "harrisons:O-05",
      "title": "Spoilage by collection-to-factory time band (aggregate)",
      "kind": "aggregate",
      "version": "2026-01",
      "tags": [
        "latex",
        "spoilage",
        "transport",
        "delay",
        "time-band"
      ],
      "summary": "Total spoilage averages 3.6% of latex collected where the collection-to-factory time is under 2.5 hours, against 5.3% where it exceeds 3.5 hours. Cells with fewer than three estates are suppressed.",
      "body_file": "source/O-05-02.md",
      "concepts": [
        "concept:latex-collection-and-transport"
      ]
    },
    {
      "id": "harrisons:O-05-03",
      "datapoint": "harrisons:O-05",
      "title": "Cause mix across the year (aggregate)",
      "kind": "aggregate",
      "version": "2026-01",
      "tags": [
        "latex",
        "spoilage",
        "contamination",
        "temperature"
      ],
      "summary": "Contamination losses stay between 0.77% and 0.85% of latex collected in every month, so they are a steady, controllable cause. Temperature-related losses peak in March-May at about 1.1% of latex collected.",
      "body_file": "source/O-05-03.md",
      "concepts": [
        "concept:contamination-control",
        "concept:latex-pre-coagulation"
      ]
    },
